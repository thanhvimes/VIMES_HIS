NODE_ENV=development
PDF_SIGNING_PORT=8080
PDF_SIGNING_BIND=127.0.0.1
PDF_SIGNING_CONTAINER_NAME=vimes-pdf-signing
SIGNING_SERVICE_VERSION=0.1.0
# test chỉ dùng contract/smoke; production bắt buộc pkcs12/pkcs11/remote-ca/local-agent.
SIGNING_PROVIDER=test
SIGNING_PROFILE=PAdES-B-T
SIGNING_MAX_PDF_BYTES=26214400
SIGNING_MAX_OUTPUT_BYTES=31457280
SIGNING_MAX_CONCURRENCY=4
SIGNING_IDEMPOTENCY_TTL_SECONDS=900
SIGNING_TSA_URL=
SIGNING_OCSP_URL=
SIGNING_CRL_URL=
SIGNING_PFX_PASSWORD=change-me-test-only
# Chỉ cần khi SIGNING_PROVIDER=pkcs12 và file được mount vào secrets/signing.pfx.
SIGNING_PFX_PATH=/run/secrets/signing.pfx
