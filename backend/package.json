{
  "name": "clinic-backend",
  "version": "1.0.0",
  "description": "Clinic Management System Backend",
  "main": "src/server.ts",
  "scripts": {
    "start": "ts-node src/server.ts",
    "dev": "nodemon",
    "typecheck": "tsc --noEmit",
