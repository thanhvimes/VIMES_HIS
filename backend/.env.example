# ===================================================================
# VIMES HIS BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Sao chép file này thành .env và thay đổi các tham số tương ứng
# ===================================================================

# Môi trường chạy (development | production)
NODE_ENV=production

# Cổng lắng nghe của Backend Server
PORT=3002

# Danh sách domain/IP frontend được phép gọi API (phân cách bằng dấu phẩy)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.1.10:5173

# Giới hạn kích thước payload JSON
REQUEST_BODY_LIMIT=10mb

# -------------------------------------------------------------------
# CẤU HÌNH CƠ SỞ DỮ LIỆU POSTGRESQL (HIS / VIMES_NB)
# -------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=vimes_his
DB_USER=postgres
DB_PASSWORD=thay_bang_mat_khau_db_that

# -------------------------------------------------------------------
# CẤU HÌNH BẢO MẬT & MÃ HÓA
# -------------------------------------------------------------------
JWT_SECRET=thay_bang_chuoi_ngau_nhien_toi_thieu_32_ky_tu
JWT_EXPIRES_IN=8h
VIMES_SECURITY_KEY=thay_bang_chuoi_ngau_nhien_toi_thieu_32_ky_tu
ADMIN_PASSWORD=thay_bang_mat_khau_admin_mac_dinh

# -------------------------------------------------------------------
# CẤU HÌNH CÁC DỊCH VỤ NGOÀI (TÙY CHỌN)
# -------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

SMS_PROVIDER=caresoft
SMS_CARESOFT_URL=
SMS_CARESOFT_TOKEN=
SMS_CARESOFT_SERVICE_ID=

PACS_STORAGE_DIR=./uploads

# -------------------------------------------------------------------
# DOCUMENT ENGINE (CARBONE ON-PREMISE)
# -------------------------------------------------------------------
CARBONE_URL=http://127.0.0.1:4000
CARBONE_TOKEN=
CARBONE_TIMEOUT_MS=30000
# L = LibreOffice, O = OnlyOffice
CARBONE_CONVERTER=L
DOCUMENT_TEMPLATE_DIR=./templates/documents
TEMPLATE_STUDIO_STORAGE_DIR=./storage/template-studio
TEMPLATE_STUDIO_ENFORCE_PERMISSIONS=false
# Số render đồng thời trên mỗi backend instance; benchmark trước khi tăng.
DOCUMENT_RENDER_CONCURRENCY=8
# Backpressure: từ chối sớm thay vì làm tràn RAM khi converter quá tải.
DOCUMENT_RENDER_QUEUE_SIZE=200
DOCUMENT_RENDER_QUEUE_WAIT_MS=15000
