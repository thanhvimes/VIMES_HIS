{
  "manifest_version": 3,
  "name": "VIMES HIS - Workstation Signing Bridge",
  "version": "1.2.0",
  "description": "Cầu nối ký số bảo mật và in ấn máy trạm cho hệ thống bệnh viện VIMES HIS.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:18181/*",
    "https://127.0.0.1:18182/*",
    "http://localhost:18181/*",
    "https://localhost:18182/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
