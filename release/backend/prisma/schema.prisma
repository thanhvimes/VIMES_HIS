datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==================== EXISTING MODELS ====================

// Bảng Bệnh nhân (Giữ nguyên để tham khảo nếu cần)
model Patient {
  id            String   @id @default(uuid())
  recordNumber  String   @unique
  name          String
  dob           DateTime
  gender        String
  phone         String?
  address       String?
  identityCard  String?
  insuranceCard String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Bảng dữ liệu gửi giấy tờ (Theo cấu trúc người dùng cung cấp)
model BhDocument {
  id              Int       @id @default(autoincrement())
  patientId       String?   @db.VarChar(20)
  patientName     String?   @map("patientname") @db.VarChar(80)
  docNo           String?   @map("docno") @db.VarChar(20)
  typeCode        String?   @map("typeCode") @db.VarChar(10)
  typeName        String?   @map("typeName") @db.VarChar(60)
  xmlData         String?   @map("xmlData") @db.VarChar(4080)
  signatureStatus String?   @map("signatureStatus") @db.VarChar(20)
  sendStatus      String?   @map("sendStatus") @db.VarChar(20)
  sentAt          DateTime? @default(now()) @map("sentAt")
  transactionId   String?   @map("transactionId") @db.VarChar(20)
  errorMessage    String?   @map("errorMessage") @db.VarChar(20)
  createdAt       DateTime? @default(now()) @map("createdAt")
  updatedAt       DateTime? @updatedAt @map("updatedAt")

  @@map("bh_document")
}

// ==================== ONLINE BOOKING MODELS ====================

// Bảng đặt lịch khám online
model Booking {
  id              Int       @id @default(autoincrement())
  bookingId       String    @unique @map("booking_id") @db.VarChar(20)
  
  // Thông tin bệnh nhân
  patientId       String?   @map("patient_id") @db.VarChar(20)
  patientName     String    @map("patient_name") @db.VarChar(100)
  phone           String    @db.VarChar(15)
  dob             String    @db.VarChar(10)
  gender          String    @db.VarChar(10)
  identityCard    String?   @map("identity_card") @db.VarChar(20)
  identityIssueDate String? @map("identity_issue_date") @db.VarChar(10)
  
  // Địa chỉ
  provinceId      String?   @map("province_id") @db.VarChar(5)
  districtId      String?   @map("district_id") @db.VarChar(5)
  wardId          String?   @map("ward_id") @db.VarChar(5)
  addressDetail   String?   @map("address_detail") @db.VarChar(200)
  
  // Thông tin đặt lịch
  specialityId    String    @map("speciality_id") @db.VarChar(10)
  bookingDate     String    @map("booking_date") @db.VarChar(10)
  bookingTime     String    @map("booking_time") @db.VarChar(5)
  reason          String?   @db.VarChar(500)
  isPriority      Boolean   @default(false) @map("is_priority")
  
  // Trạng thái
  status          String    @default("Pending") @db.VarChar(20)
  smsStatus       String    @default("Pending") @map("sms_status") @db.VarChar(20)
  source          String    @default("Portal") @db.VarChar(20)
  
  // Queue info (sau khi duyệt)
  queueNumber     Int?      @map("queue_number")
  
  // Timestamps
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  
  @@map("bookings")
  @@index([bookingDate, bookingTime])
  @@index([status])
  @@index([phone])
}

// Danh mục chuyên khoa online
model OnlineSpeciality {
  id            String   @id @db.VarChar(10)
  name          String   @db.VarChar(100)
  description   String?  @db.VarChar(500)
  quotaPerSlot  Int      @map("quota_per_slot")
  active        Boolean  @default(true)
  
  @@map("dm_chuyenkhoa_online")
}

// Khung giờ khám
model TimeSlot {
  id          Int      @id @default(autoincrement())
  timeSlot    String   @unique @map("time_slot") @db.VarChar(5)
  maxQuota    Int      @map("max_quota")
  active      Boolean  @default(true)
  
  @@map("dm_khung_gio")
}

// Địa giới hành chính - Tỉnh/Thành phố
model Province {
  id      String @id @map("ma_tinh") @db.VarChar(5)
  name    String @map("ten_tinh") @db.VarChar(100)
  
  @@map("dm_tinh")
}

// Địa giới hành chính - Quận/Huyện
model District {
  id          String @id @map("ma_huyen") @db.VarChar(5)
  provinceId  String @map("ma_tinh") @db.VarChar(5)
  name        String @map("ten_huyen") @db.VarChar(100)
  
  @@map("dm_huyen")
}

// Địa giới hành chính - Phường/Xã
model Ward {
  id          String @id @map("ma_xa") @db.VarChar(5)
  districtId  String @map("ma_huyen") @db.VarChar(5)
  name        String @map("ten_xa") @db.VarChar(100)
  
  @@map("dm_xa")
}

// Log thao tác booking
model BookingLog {
  id          Int      @id @default(autoincrement())
  bookingId   String   @map("booking_id") @db.VarChar(20)
  action      String   @db.VarChar(50)
  userId      String?  @map("user_id") @db.VarChar(20)
  note        String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")
  
  @@map("booking_logs")
  @@index([bookingId])
}